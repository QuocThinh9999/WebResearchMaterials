PGHOST=localhost
PGPORT=5432
PGDATABASE=web_research_materials
PGUSER=postgres
PGPASSWORD=thay_bang_mat_khau_cua_ban
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=10
PGAPPNAME=web_research_materials

APP_SECRET_KEY=UngDungTriTueNhanTao
COOKIE_SECURE=false
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
# Số lần thử tối đa cho mỗi URL và số lần chuyển hướng HTTPS công khai.
PDF_MAX_REDIRECTS=3
PDF_MAX_RETRIES=3
# Số tài liệu tải đồng thời và số request đồng thời tới cùng một máy chủ.
PDF_DOWNLOAD_WORKERS=6
PDF_DOWNLOAD_PER_HOST=2
PDF_BROWSER_ENABLED=true
# Chrome riêng chạy ẩn cho PDF công khai. Chrome thường cần người dùng cho phép kết nối trong Chrome.
PDF_BROWSER_PROFILE_DIR=.pdf-browser-profile
PDF_BROWSER_HEADLESS=true
# Tùy chọn: kết nối Chrome có hồ sơ riêng đã mở cổng điều khiển cục bộ.
PDF_BROWSER_CDP_URL=
# Email liên hệ để truy vấn Unpaywall và nhóm truy cập lịch sự của Crossref/OpenAlex.
UNPAYWALL_EMAIL=

SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=
SCOPUS_API_URL=https://api.elsevier.com/content/search/scopus
WOS_API_KEY=
WOS_API_URL=https://api.clarivate.com/api/wos
API_TIMEOUT_SECONDS=30
SEARCH_MAX_RESULTS=500

# Ollama chạy local, không cần API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=900
AI_RELEVANCE_THRESHOLD=70
AI_TOP_CHUNKS=8
AI_MAX_RETRIES=3
AI_LOOKUP_WORKERS=2
AI_ALLOW_PDF_VISION=false

# Chỉ cấu hình khi chạy kiểm thử tích hợp. Không dùng database thật.
TEST_DATABASE_URL=
